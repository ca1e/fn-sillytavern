appname               = fn-sillytavern
version               = 1.19.0
display_name          = SillyTavern
desc                  = SillyTavern（酒馆）是一个面向高级用户的本地 LLM 前端，支持接入 OpenAI、Claude、Gemini、OpenRouter 及本地模型等进行 AI 角色扮演与对话创作。本应用内置 SillyTavern 1.19.0，安装时通过 npm 安装依赖（可选国内镜像），通过 fnOS 桌面一键打开，数据持久化于应用的共享目录，升级保留聊天记录与角色卡。访问控制默认仅放行所在网段，可在安装向导中追加白名单。
platform              = x86
source                = thirdparty
maintainer            = SillyTavern Team
maintainer_url        = https://github.com/SillyTavern/SillyTavern
distributor           = chaos
distributor_url       = https://github.com/tnnevol/fn-os-apps
os_min_version        = 1.1.3100
desktop_uidir         = ui
desktop_applaunchname = fn-sillytavern.main
service_port          = 8000
install_dep_apps      = nodejs_v24
disable_authorization_path = true
checkport             = false
changelog             = 首个版本，内置 SillyTavern 1.19.0；支持安装向导配置端口、npm 镜像与额外白名单网段；自动探测 NAS 所在网段加入访问白名单；数据持久化，卸载可选保留
