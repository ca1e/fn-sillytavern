#!/bin/bash

### Start / stop / status control for the SillyTavern service and its
### fnOS unified-gateway bridge process.

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
GATEWAY_PID_FILE="${TRIM_PKGVAR}/gateway.pid"
RESTART_MARK_FILE="${TRIM_PKGVAR}/internal-restart"

NODE_BIN="/var/apps/nodejs_v24/target/bin"
NODE_EXEC="${NODE_BIN}/node"

APP_NAME="${TRIM_APPNAME:-fn-sillytavern}"
ST_DIR="${TRIM_APPDEST}/sillytavern"
GATEWAY_SCRIPT="${TRIM_APPDEST}/gateway-proxy.mjs"
GATEWAY_SOCKET="${TRIM_APPDEST}/app.sock"
GATEWAY_PREFIX="/app/${APP_NAME}"

APP_SHARE="${TRIM_APPDEST_VOL}/@appshare/${APP_NAME}"
CONFIG_FILE="${APP_SHARE}/config/config.yaml"
DATA_ROOT="${APP_SHARE}/data"
APP_HOME="${APP_SHARE}/home"

PORT="${wizard_port:-8000}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [main] $1" >>"${LOG_FILE}"
}

# Truncate the log if it grows beyond 10 MB.
if [ -f "${LOG_FILE}" ]; then
    log_size="$(stat -c%s "${LOG_FILE}" 2>/dev/null || echo 0)"
    if [ "${log_size}" -gt 10485760 ]; then
        : >"${LOG_FILE}"
    fi
fi

check_process() {
    local pid="$1"
    if [ -d "/proc/${pid}" ]; then
        local state
        state="$(awk '{print $3}' "/proc/${pid}/stat" 2>/dev/null)"
        if [ "${state}" = "Z" ] || [ "${state}" = "X" ]; then
            return 1
        fi
        kill -0 "${pid}" 2>/dev/null
        return $?
    fi
    return 1
}

read_pid() {
    head -n 1 "$1" 2>/dev/null | tr -d '[:space:]'
}

# Live check based on the PID files only (no restart grace). Used by
# start_process to decide whether new processes must be launched.
is_running() {
    if [ -f "${PID_FILE}" ]; then
        pid="$(read_pid "${PID_FILE}")"
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

gateway_running() {
    if [ -f "${GATEWAY_PID_FILE}" ]; then
        gpid="$(read_pid "${GATEWAY_PID_FILE}")"
        if check_process "${gpid}"; then
            return 0
        fi
        rm -f "${GATEWAY_PID_FILE}"
    fi
    return 1
}

# Service status as reported to the service manager: running when the app is
# alive OR during the 120s internal-restart grace window, so the service
# manager does not tear the app down mid-restart.
status() {
    if is_running; then
        return 0
    fi

    if [ -f "${RESTART_MARK_FILE}" ]; then
        mark_ts="$(read_pid "${RESTART_MARK_FILE}")"
        now_ts="$(date +%s)"
        if [ -n "${mark_ts}" ] && [ $((now_ts - mark_ts)) -lt 120 ]; then
            return 0
        fi
        rm -f "${RESTART_MARK_FILE}"
    fi

    return 1
}

start_st() {
    if [ ! -x "${NODE_EXEC}" ]; then
        log_msg "ERROR: node runtime not found at ${NODE_EXEC} (install_dep_apps nodejs_v24 missing?)"
        return 1
    fi

    if [ ! -f "${ST_DIR}/server.js" ]; then
        log_msg "ERROR: SillyTavern source not found at ${ST_DIR}/server.js"
        return 1
    fi

    if [ ! -d "${ST_DIR}/node_modules" ]; then
        log_msg "ERROR: dependencies not installed at ${ST_DIR}/node_modules (install_callback did not run?)"
        return 1
    fi

    mkdir -p "${DATA_ROOT}" "${APP_HOME}" "${APP_SHARE}/config"

    log_msg "Starting SillyTavern (port: ${PORT}) ..."
    cd "${ST_DIR}" || return 1
    HOME="${APP_HOME}" \
        PATH="${NODE_BIN}:${PATH}" \
        bash -c "exec '${NODE_EXEC}' server.js \
            --listen \
            --port '${PORT}' \
            --configPath '${CONFIG_FILE}' \
            --dataRoot '${DATA_ROOT}' \
            --browserLaunchEnabled false" >>"${LOG_FILE}" 2>&1 &
    printf "%s" "$!" >"${PID_FILE}"
    log_msg "SillyTavern started with pid $!"
    return 0
}

start_gateway() {
    if [ ! -f "${GATEWAY_SCRIPT}" ]; then
        log_msg "WARN: gateway script missing at ${GATEWAY_SCRIPT}, desktop entry will not work."
        return 1
    fi

    # Reclaim orphaned gateways whose pid file was lost; the marker matches
    # only this app's proxy script path.
    pkill -f "${APP_NAME}/gateway-proxy.mjs" >/dev/null 2>&1
    sleep 0.3
    rm -f "${GATEWAY_SOCKET}"

    log_msg "Starting gateway bridge (${GATEWAY_PREFIX} -> 127.0.0.1:${PORT}) ..."
    cd "${TRIM_APPDEST}" || return 1
    GATEWAY_SOCKET="${GATEWAY_SOCKET}" \
        GATEWAY_PREFIX="${GATEWAY_PREFIX}" \
        UPSTREAM_HOST="127.0.0.1" \
        UPSTREAM_PORT="${PORT}" \
        PATH="${NODE_BIN}:${PATH}" \
        bash -c "exec '${NODE_EXEC}' '${GATEWAY_SCRIPT}'" >>"${LOG_FILE}" 2>&1 &
    printf "%s" "$!" >"${GATEWAY_PID_FILE}"
    log_msg "Gateway bridge started with pid $!"
    return 0
}

stop_pid_file() {
    local pid_file="$1"
    local label="$2"

    if [ ! -r "${pid_file}" ]; then
        return 0
    fi

    local pid
    pid="$(read_pid "${pid_file}")"
    if ! check_process "${pid}"; then
        rm -f "${pid_file}"
        return 0
    fi

    log_msg "send TERM signal to ${label} PID:${pid}..."
    kill -TERM "${pid}" >>"${LOG_FILE}" 2>&1

    local count=0
    while check_process "${pid}" && [ ${count} -lt 10 ]; do
        sleep 1
        count=$((count + 1))
        log_msg "waiting ${label} terminate... (${count}s/10s)"
    done

    if check_process "${pid}"; then
        log_msg "send KILL signal to ${label} PID:${pid}..."
        kill -KILL "${pid}" >>"${LOG_FILE}" 2>&1
        sleep 1
    fi

    rm -f "${pid_file}"
    return 0
}

start_process() {
    if ! is_running; then
        start_st || return 1
    else
        log_msg "SillyTavern already running, skip start."
    fi

    if ! gateway_running; then
        start_gateway || return 1
    else
        log_msg "Gateway bridge already running, skip start."
    fi
    return 0
}

stop_process() {
    if [ "${FNOS_INTERNAL_RESTART}" != "1" ]; then
        rm -f "${RESTART_MARK_FILE}"
    fi

    log_msg "Stopping gateway bridge and SillyTavern ..."

    stop_pid_file "${GATEWAY_PID_FILE}" "gateway"
    rm -f "${GATEWAY_SOCKET}"
    pkill -f "${APP_NAME}/gateway-proxy.mjs" >/dev/null 2>&1

    stop_pid_file "${PID_FILE}" "SillyTavern"
    log_msg "Stopped."
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
